# Required: Set a strong random string for JWT token signing
JWT_SECRET=replace-with-a-long-random-secret

# Required: base64-encoded 32-byte key for journal encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JOURNAL_ENCRYPTION_KEY=replace-with-a-base64-32-byte-key

# Optional: Port for the API server (default: 4000)
PORT=4000

# Optional: Allowed CORS origin (default: http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000

# Optional: enable external AI processing. Journal text is sent to OpenAI only
# when this is exactly "true" and OPENAI_API_KEY is configured.
ALLOW_EXTERNAL_AI=false

# Optional: OpenAI API key for AI-powered reflection insights
# If either setting is disabled, the API uses local reflection summaries.
OPENAI_API_KEY=

# Optional: OpenAI model to use (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
